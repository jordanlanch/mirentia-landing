# nginx config for the Mirentia landing — TEMPLATE, not a plain conf.
#
# This file is mounted into /etc/nginx/templates/default.conf.template so the
# stock nginx image's own /docker-entrypoint.d/20-envsubst-on-templates.sh
# renders it into /etc/nginx/conf.d/default.conf at container start.
#
# WHY A TEMPLATE: nginx's `env` directive is `main` context ONLY, so it cannot
# go inside this file (conf.d/*.conf is included from inside `http {}`).
# Declaring `env API_UPSTREAM;` in `server {}` fails at parse time with:
#     [emerg] "env" directive is not allowed here in .../default.conf:16
# and the container never starts. envsubst is the supported way to get an
# environment variable into a conf.d fragment.
#
# NGINX_ENVSUBST_FILTER must stay set (see docker-compose.yml). Without it the
# entrypoint substitutes EVERY environment variable and would eat nginx's own
# $host / $uri / $scheme / $remote_addr.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    # The site already sends a strict CSP in the panel's proxy; keep nginx
    # from adding anything that would loosen it.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Docker's embedded DNS.
    #
    # nginx resolves a LITERAL upstream at startup and refuses to boot when the
    # name does not resolve:
    #     [emerg] host not found in upstream "mirentia-api-web-1"
    # which crash-loops the whole landing (restart: unless-stopped) every time
    # the backend compose is down, redeploying, or not yet attached to the
    # shared network. Resolving through a variable defers the lookup to request
    # time: the static site stays up and /api/ answers 502 until the backend is
    # actually reachable. verified: site 200 + /api 502 with an unresolvable
    # upstream, and 201 from the stub once it resolves.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # The capture form. ${API_UPSTREAM} is substituted by the entrypoint, so
    # the backend host lives in the environment, not in this file.
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # Hashed assets never change under the same name.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /cases/ {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location /okrs/ {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Single-page-ish routing for the funnel anchors; index.html serves the
    # whole page and the anchors are client-side.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    error_page 404 /index.html;
}
