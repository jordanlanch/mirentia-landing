# nginx config for the Mirentia landing.
#
# Two jobs: serve the static site correctly, and forward the funnel capture
# endpoint to the Go backend so the form works from the same origin (which
# is what the CSP in the site already assumes — connect-src includes 'self').
#
# This file is copied into /etc/nginx/conf.d/ by the Dockerfile, NOT bind
# mounted: /etc/nginx/conf.d/default.conf is a symlink in the official nginx
# image and both a mount and a COPY onto it fail.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # NOTE ON $API_UPSTREAM
    # This file is a TEMPLATE. The nginx entrypoint runs envsubst over
    # /etc/nginx/templates/*.template at boot and writes the result to
    # /etc/nginx/conf.d/, substituting ONLY the variables present in the
    # container environment. That is why $API_UPSTREAM resolves here and
    # the nginx runtime variables ($host, $remote_addr, $scheme) do not
    # get clobbered.
    #
    # Two things that do NOT work, both tried and rejected:
    #   - `env API_UPSTREAM;` in this server block:
    #       '"env" directive is not allowed here' (it is main-context only,
    #       and conf.d/*.conf is included from inside `http`).
    #   - `env API_UPSTREAM;` at the top of nginx.conf:
    #       still `unknown "api_upstream" variable`, because env only
    #       preserves the variable for modules to read; it does not make it
    #       substitutable inside the config text.

    charset utf-8;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The capture form. API_UPSTREAM comes from the container environment so
    # the backend host is not hardcoded here.
    location /api/ {
        proxy_pass http://$API_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # Hashed assets never change under the same name.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /cases/ {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location /okrs/ {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}